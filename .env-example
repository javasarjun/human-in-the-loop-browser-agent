OPENAI_API_KEY=your_openai_key_here
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=human-in-loop-browser-agent-backend-dev-approval-requests
UPLOAD_BUCKET_NAME=human-in-loop-browser-agent-backend-dev-youraccountid-uploads

# Optional. Leave empty for local development - the password gate is skipped
# when this variable is unset. Set it on the App Runner deployment so the
# public URL isn't open to the world.
STREAMLIT_APP_PASSWORD=
